// Camp — the player's home base, rendered first-person like everywhere else.
// Lives outside assets/zones/ deliberately: it's a place, not a contract
// zone, so the catalog and contract board never see it.
//
// The cabin fronts a clearing; the gun rack and optics shelf anchor to the
// cabin wall (item objects are placed by the app — they're dynamic stock,
// not zone content). Trailhead signposts stand along the north fence.
ZoneSource(
    name: "Camp",
    seed: 900,
    size_m: (60.0, 60.0),
    ambient_biome: Grass,
    features: [
        // The cabin (a sturdy shed) and its storeroom.
        Shed(pos: (26.0, 0.0, 34.0)),
        FeedShed(pos: (36.0, 0.0, 34.0)),
        // Lantern posts light the yard — emissive, so NV blooms at home.
        StreetlightRow(from: (22.0, 0.0, 28.0), to: (40.0, 0.0, 28.0), gap_m: 18.0),
        // Log pile by the fire ring.
        Deadfall(pos: (18.0, 0.0, 24.0), radius_m: 2.5),
        // Perimeter fence with a gap on the north side (the trailheads).
        FenceLine(from: (6.0, 0.0, 6.0), to: (54.0, 0.0, 6.0), post_gap_m: 3.0),
        FenceLine(from: (6.0, 0.0, 6.0), to: (6.0, 0.0, 54.0), post_gap_m: 3.0),
        FenceLine(from: (54.0, 0.0, 6.0), to: (54.0, 0.0, 54.0), post_gap_m: 3.0),
        // Tree line behind the cabin.
        TreeRow(from: (8.0, 0.0, 50.0), to: (52.0, 0.0, 52.0), count: 7, kind: Pine),
    ],
    spawn_tables: [],
    friendlies: [
        // The camp dog keeps you company between nights.
        (species: Dog, patrol: [(30.0, 0.0, 20.0), (22.0, 0.0, 30.0), (38.0, 0.0, 26.0), (30.0, 0.0, 20.0)]),
    ],
    hazards: [],
    zombie_weight: 0.0,
    connections: [],
    contracts_hint: [],
)
